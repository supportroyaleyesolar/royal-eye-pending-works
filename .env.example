# Royal Eye Solar Power – Environment Variables Configuration
# Copy this to .env or configure in Netlify Dashboard -> Site configuration -> Environment variables

# Google Gemini Vision API (for automated Aadhaar/PAN/Electricity Bill extraction)
VITE_GEMINI_API_KEY=

# Supabase Cloud PostgreSQL & Realtime (Optional - can also be configured inside Settings UI)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
